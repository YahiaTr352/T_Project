# ==============================================================================
# Alsorayia App — Environment Variables Template
# Copy this file to `.env.local` or configure secrets in EAS for CI/CD builds.
# Never commit real secrets or service account JSON files to the repository.
# ==============================================================================

# Backend API base URL (without trailing slash)
EXPO_PUBLIC_API_BASE_URL=https://alsorayia.com/api

# Google Maps SDK Key (iOS & Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
