{
  "name": "alsorayia-app",
  "main": "expo-router/entry",
  "version": "1.2.4",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:dev": "eas build --profile development",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "build:prod": "npm run bump:patch && eas build --profile production",
    "build:prod:android": "npm run bump:patch && eas build --profile production --platform android",
    "build:prod:ios": "npm run bump:patch && eas build --profile production --platform ios",
    "build:prod:all": "npm run bump:patch && eas build --profile production --platform all",
    "submit:prod": "eas submit --profile production --latest",
    "submit:prod:android": "eas submit --profile production -p android --latest",
    "submit:prod:ios": "eas submit --profile production -p ios --latest",
    "update": "eas update",
    "update:preview": "eas update --channel preview",
    "update:preview:android": "eas update --channel preview --platform android",
    "update:preview:ios": "eas update --channel preview --platform ios",
    "update:prod": "eas update --channel production",
    "update:prod:android": "eas update --channel production --platform android",
    "update:prod:ios": "eas update --channel production --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "axios": "^1.14.0",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "^57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "^57.0.7",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-video-thumbnails": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-render-html"
        ]
      }
    }
  }
}
